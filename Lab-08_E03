#include <iostream>
using namespace std;

// PROTOTIPOS
int leerDias();
double leerVenta();
int clasificarVenta(double venta);
double calcularTotal(int dias, int &diasAltos);
void mostrarResultados(double total, double promedio,
                       int diasAltos);

// PROGRAMA PRINCIPAL
int main() {

    int dias, diasAltos;
    double total, promedio;



    diasAltos = 0;
    total = calcularTotal(dias, diasAltos);
    promedio = total / dias;

    mostrarResultados(total, promedio, diasAltos);
    dias = leerDias();

    return 0;
}

// FUNCION 1: LEER DIAS CON DO-WHILE
int leerDias() {

    int dias;

    do {
        cout << "Ingrese cantidad de dias: ";
        cin >> dias;

    } while (dias <= 0);

    return dias;//5
}

// FUNCION 2: LEER VENTA CON DO-WHILE
double leerVenta() {//458

    double venta;

    do {
        cout << "Ingrese el monto vendido: ";
        cin >> venta;//458

    } while (venta < 0);

    return venta;
}

// FUNCION 3: CONDICIONES ANIDADAS
int clasificarVenta(double venta) {//458

    int categoria;

    if (venta > 1000) {

        if (venta > 2000) {
            categoria = 4; // Excelente
        } else {
            categoria = 3; // Alta
        }

    } else {

        if (venta < 500) {
            categoria = 1; // Baja //452
        } else {
            categoria = 2; // Regular
        }
    }

    return categoria;//1
}

// FUNCION 4: PROCESAR VENTAS CON FOR
double calcularTotal(int dias, int &diasAltos) {

    int i, categoria;
    double venta, total;

    total = 0;

    for (i = 1; i <= dias; i++) { //dias =5

        cout << "\nDia " << i << endl;

        venta = leerVenta();//4812
        categoria = clasificarVenta(venta);//4

        total = total + venta;

        if (categoria >= 3) {
            diasAltos = diasAltos + 1;//1
        }

        if (categoria == 1) {
            cout << "Venta baja" << endl;
        } else if (categoria == 2) {
            cout << "Venta regular" << endl;
        } else if (categoria == 3) {
            cout << "Venta alta" << endl;
        } else {
            cout << "Venta excelente" << endl;
        }
    }

    return total;
}

// FUNCION 5: MOSTRAR RESULTADOS
void mostrarResultados(double total, double promedio,
                       int diasAltos) {

    cout << "\nRESULTADOS FINALES" << endl;
    cout << "Total vendido: Bs " << total << endl;
    cout << "Promedio diario: Bs " << promedio << endl;
    cout << "Dias con ventas superiores a Bs 1000: "
         << diasAltos << endl;
}
