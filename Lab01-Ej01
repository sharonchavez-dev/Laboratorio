Algoritmo SumaDosNumeros
	// Definición de variables como números reales
	Definir num1, num2, suma, resta Como Real
	
	// Solicitar el primer número al usuario
	Escribir "Ingrese el primer número:"
	Leer num1
	
	// Solicitar el segundo número al usuario
	Escribir "Ingrese el segundo número:"
	Leer num2
	
	// Operación de suma
	suma <- num1 + num2
	resta <- num1 - num2
	
	// Mostrar el resultado
	Escribir "La suma de los dos números es: ", suma, resta
FinAlgoritmo
